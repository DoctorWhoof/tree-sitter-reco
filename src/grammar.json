        },
        {
          "type": "STRING",
          "value": "false"
        }
      ]
    },
    "number": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "0b[01_]+"
        },
        {
          "type": "PATTERN",
          "value": "0x[0-9a-fA-F_]+"
        },
        {
          "type": "PATTERN",
          "value": "\\d[\\d_]*"
        }
      ]
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
